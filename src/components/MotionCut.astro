---
// Motion cut of a chart (rendered by projects/motion-viz in metis-os), set inline in the prose
// like a GIF: no frame, no controls, same paper as the page. Plays from the top on scrolling
// into view, pauses on leaving, tap to pause or resume. Reduce Motion keeps the still until tapped.
//
// With `steps` it becomes a step-through instead (Mayer's segmenting: one idea per beat, the
// reader sets the pace). With motion on it plays itself to the first step on view; under Reduce
// Motion it opens on `point`, the takeaway in one line, with a visible "Step through" button
// under the chart (never over the data) so the first tap never reads as dead space. Each step
// plays to its time and holds with its caption; Next moves on. After the last step it plays
// out, the point returns, and the button offers a replay. Under Reduce Motion each tap jumps
// straight to a step's frame, so nothing moves. Step times come from the motion-viz engine
// (beats.mjs); point and captions restate the piece's own prose and data.
interface Step { at: number; text: string }
interface Props { src: string; poster: string; label: string; steps?: Step[]; point?: string }
const { src, poster, label, steps, point } = Astro.props;
---

{steps?.length ? (
  <figure class="motion-step" data-steps={JSON.stringify(steps)} data-point={point ?? ''}>
    <div>
      <video class="motion" muted playsinline preload="metadata" poster={poster} src={src} aria-label={label}></video>
    </div>
    <figcaption>
      <button type="button" class="step-btn">
        <span class="step-btn-label">Step through</span>
        <span class="step-btn-count"></span>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <span class="step-text" aria-live="polite"></span>
    </figcaption>
  </figure>
) : (
  <video class="motion" muted loop playsinline preload="none" poster={poster} src={src} aria-label={label}></video>
)}

<script>
  type Step = { at: number; text: string };
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = new WeakSet<HTMLVideoElement>();
  const stepped = new WeakSet<HTMLVideoElement>();

  // Step-through. at = index of the step on screen (-1 = the opening, steps.length = the end);
  // moving = playing toward step at+1.
  for (const fig of document.querySelectorAll<HTMLElement>('figure.motion-step')) {
    const v = fig.querySelector('video')!;
    const btn = fig.querySelector<HTMLButtonElement>('.step-btn')!;
    const label = fig.querySelector<HTMLElement>('.step-btn-label')!;
    const count = fig.querySelector<HTMLElement>('.step-btn-count')!;
    const text = fig.querySelector<HTMLElement>('.step-text')!;
    const steps: Step[] = JSON.parse(fig.dataset.steps!);
    const point = fig.dataset.point || '';
    const N = steps.length;
    let at = -1, moving = false, raf = 0;
    stepped.add(v);

    const render = () => {
      const open = at < 0, end = at >= N;
      fig.classList.toggle('is-point', open || end);
      text.textContent = open || end ? point : steps[at].text;
      label.textContent = open ? 'Step through' : end ? 'Replay' : at === N - 1 ? 'Finish' : 'Next';
      count.textContent = open ? `${N} steps` : end ? '' : `${at + 1} of ${N}`;
      btn.hidden = moving;
    };
    const watch = () => {
      const target = at + 1;
      if (target < N && v.currentTime >= steps[target].at) {
        v.pause(); v.currentTime = steps[target].at; at = target; moving = false; render(); return;
      }
      raf = requestAnimationFrame(watch);
    };
    const playOn = () => {
      moving = true; render();
      v.play().catch(() => { moving = false; render(); });
      cancelAnimationFrame(raf); raf = requestAnimationFrame(watch);
    };
    const next = () => {
      if (still) {
        // Reduce Motion: jump frame to frame, no playback
        at = at >= N ? 0 : at + 1;
        const end = Number.isFinite(v.duration) ? v.duration - 0.05 : steps[N - 1].at;
        v.currentTime = at < N ? steps[at].at : end;
        render();
        return;
      }
      if (moving) { v.pause(); cancelAnimationFrame(raf); moving = false; render(); return; }
      if (at < 0 || at >= N) { at = -1; v.currentTime = 0; }
      playOn();
    };
    v.addEventListener('ended', () => { cancelAnimationFrame(raf); at = N; moving = false; render(); });
    btn.addEventListener('click', next);
    v.addEventListener('click', next);
    render();
    // With motion on it still starts itself on first view (the GIF feel), then waits at step 1.
    if (!still) new IntersectionObserver((es, o) => {
      if (es.some((e) => e.isIntersecting)) { o.disconnect(); if (at < 0 && !moving) playOn(); }
    }, { threshold: 0.4 }).observe(v);
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (!e.isIntersecting) { v.pause(); continue; }
      if (still) continue;
      if (!seen.has(v)) { seen.add(v); v.currentTime = 0; }
      v.play().catch(() => {});
    }
  }, { threshold: 0.4 });
  for (const v of document.querySelectorAll<HTMLVideoElement>('video.motion')) {
    if (stepped.has(v)) continue; // step-throughs wait for the reader
    io.observe(v);
    v.addEventListener('click', () => (v.paused ? v.play().catch(() => {}) : v.pause()));
  }
</script>

<style>
  .motion { display: block; width: 100%; height: auto; aspect-ratio: 1; margin: var(--space-3) 0 0; background: var(--paper); cursor: pointer; }
  .motion-step { margin: 0; }
  .step-btn {
    display: inline-flex; margin: 0 0 var(--space-2, 8px); align-items: center; gap: 10px;
    min-height: 44px; padding: 0 16px 0 18px; border: 0; border-radius: 999px;
    background: var(--ink, #1b1a17); color: var(--paper, #f6f3ec);
    font: 600 0.92rem/1 var(--font-sans, Inter, sans-serif); letter-spacing: 0.01em; cursor: pointer;
    
  }
  .step-btn[hidden] { display: none; }
  .step-btn:focus-visible { outline: 2px solid var(--accent, #c2410c); outline-offset: 3px; }
  .step-btn-count { font-weight: 500; opacity: 0.72; }
  .step-btn-count:empty { display: none; }
  .motion-step figcaption { min-height: 7.4em; padding-top: var(--space-2, 8px); }
  .step-text { display: block; font-family: var(--font-serif, Fraunces, serif); font-size: 1.04rem; line-height: 1.45; color: var(--ink, #1b1a17); }
  .is-point .step-text { font-weight: 600; font-size: 1.14rem; }
</style>
